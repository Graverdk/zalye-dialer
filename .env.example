# ============================================================
# ZALYE DIALER - Environment Variables
# Kopier denne fil til .env og udfyld dine værdier
# ============================================================

# Server
PORT=3000
APP_URL=https://din-server.com   # URL hvor backend kører (bruges i Pipedrive manifest)

# Relatel
# Hent dit API token på: https://app.relatel.dk/account/authorized_applications
RELATEL_ACCESS_TOKEN=dit_relatel_token_her
# Hovednummer (landekode, ingen +/00) — afgør om en SMS er ind- eller udgående
RELATEL_MAIN_NUMBER=4571747007
# Signeringsnøglen fra Relatel → Firmaadministration → Webhooks (vises kun én gang).
# Når den er sat: signaturtjek på webhooken + polling kun hvert 15. min
RELATEL_WEBHOOK_SECRET=

# Anthropic Claude (analyse + resumé + handlingspunkter + diarization)
# Hent API key på: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
# Valgfri — model til samtaleanalysen
CLAUDE_MODEL=claude-sonnet-5

# ElevenLabs Scribe (tale-til-tekst med indbygget speaker diarization)
# Hent API key på: https://elevenlabs.io/app/settings/api-keys
# Pris: ~$0.40 / time lyd (ca. 3 øre per 5-min samtale)
ELEVENLABS_API_KEY=sk-...
# Valgfri — Scribe-model (default scribe_v2)
SCRIBE_MODEL=scribe_v2

# Pipedrive
# Hent API token i Pipedrive: Indstillinger > Personlige indstillinger > API
PIPEDRIVE_API_TOKEN=dit_pipedrive_token_her
PIPEDRIVE_COMPANY_DOMAIN=zalye-sandbox  # dit subdomain på pipedrive.com
# App-credentials fra Developer Hub (bruges til OAuth + verifikation af panel-tokens)
# Udgået 23/10: Pipedrive-appen (panel i Pipedrive) er slettet. Lad dem være tomme.
# Uden dem er panel-adgangen slået fra, og kun ADMIN_SECRET giver adgang.
PIPEDRIVE_CLIENT_ID=
PIPEDRIVE_CLIENT_SECRET=
# Kun hvis du har sat en separat "JWT secret" i Developer Hub — ellers bruges client_secret
# PIPEDRIVE_JWT_SECRET=

# ============================================================
# Sikkerhed
# ============================================================
# Beskytter debug-/vedligeholdelses-endpoints (backfill, retry, debug/*).
# Uden denne er de helt deaktiverede. Generér fx med: openssl rand -hex 24
ADMIN_SECRET=
# Hvis sat: Relatel-webhooken skal kalde /api/webhook/relatel?secret=<denne>
WEBHOOK_SECRET=

# Database (SQLite - sti til databasefilen)
DB_PATH=./data/zalye.db

# Polling interval i sekunder (hvor tit vi tjekker Relatel for nye afsluttede opkald)
POLL_INTERVAL_SECONDS=30

# Fejlalarm: når Pipedrive eller Relatel svarer 401 i to kørsler i træk, sendes
# én alarm pr. time som JSON til denne webhook (Teams-workflow eller Make-scenarie,
# der mailer videre). Tom = alarmen står kun i loggen. URL'en er hemmelig.
ALERT_WEBHOOK_URL=
ALERT_EMAIL=jg@zalye.dk
